# Supabase project: "Trimora Systems" (separate from the Trimora POS
# project — this one only ever holds marketing-site data, currently just
# `leads`). Get these from Supabase Dashboard > Project Settings > API.
#
# NEXT_PUBLIC_ prefix is required (and safe here) — this is the
# anon/publishable key, meant to be exposed client-side. RLS on `leads`
# restricts the anon role to INSERT only, so this key can add leads but
# can never read, update, or delete them.
NEXT_PUBLIC_SUPABASE_URL=https://tvzbtyggphxqnstuxllp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Cal.com booking link slug (e.g. "yourname/demo"), shown as an
# embedded calendar on the lead form's success screen once set. Until you
# create a Cal.com account + event type and set this, the success screen
# shows a plain "we'll be in touch" message instead -- the form still
# works fully without it.
NEXT_PUBLIC_CAL_LINK=
